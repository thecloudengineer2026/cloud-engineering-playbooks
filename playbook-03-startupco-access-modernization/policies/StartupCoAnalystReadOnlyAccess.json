{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListAnalyticsBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::startupco-analytics-*"
        },
        {
            "Sid": "ReadAnalyticsObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::startupco-analytics-*/*"
        },
        {
            "Sid": "ViewRDSResources",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDBInstances",
                "rds:DescribeDBClusters",
                "rds:DescribeDBSnapshots",
                "rds:DescribeDBClusterSnapshots",
                "rds:DescribeDBSubnetGroups",
                "rds:DescribeEvents",
                "rds:ListTagsForResource"
            ],
            "Resource": "*"
        }
    ]
}
